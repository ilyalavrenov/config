{
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Frog.aiff &"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Frog.aiff &"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Frog.aiff &"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(curl * https://raw.githubusercontent.com/*)",
      "Bash(curl https://raw.githubusercontent.com/*)",
      "Bash(date:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run download:*)",
      "Bash(gh run list:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(golangci-lint:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(kubectl get:*)",
      "Bash(kustomize build:*)",
      "Bash(ls:*)",
      "Bash(mktemp:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(wc:*)",
      "Edit(~/.claude/skills/**)",
      "mcp__plugin_context7_context7",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Read(~/.claude/**)",
      "Read(~/go/**)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -execdir*)",
      "Bash(gh api* --field*)",
      "Bash(gh api* --input*)",
      "Bash(gh api* --method*)",
      "Bash(gh api* --raw-field*)",
      "Bash(gh api* -f *)",
      "Bash(gh api* -F *)",
      "Bash(gh api* -X *)",
      "Bash(gh pr close:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr unlock:*)",
      "Bash(git -C * branch -D*)",
      "Bash(git -C * checkout -- *)",
      "Bash(git -C * checkout .*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * config*)",
      "Bash(git -C * gc*)",
      "Bash(git -C * reset*--hard*)",
      "Bash(git -C * restore*)",
      "Bash(git -C * stash clear*)",
      "Bash(git -C * stash drop*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(git gc:*)",
      "Bash(git reset*--hard*)",
      "Bash(git restore*)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)"
    ]
  },
  "remoteControlAtStartup": true
}
